# Copy this file to .env and fill in real values. Never commit .env itself.

# BSC testnet RPC endpoint (public free endpoints work, or Ankr/QuickNode)
BSC_TESTNET_RPC_URL=

# BSC mainnet RPC endpoint (leave empty until this project is ready for
# mainnet, per this project's security rules)
BSC_MAINNET_RPC_URL=

# The operational wallet's private key for this project ONLY, dedicated,
# never shared with any other project's wallet. Fund it from the BSC
# testnet faucet, not with real funds, while this stays testnet-only.
BNB_AGENT_OPERATOR_PRIVATE_KEY=

# U token faucet doesn't need a key, just visit
# https://united-coin-u.github.io/u-faucet/ with your wallet address

# 8004scan Developer Hub API key (free Pro tier for hackathon participants)
SCAN_8004_API_KEY=

# Altana SDK key, if/when their office hours confirm one is needed for
# hackathon use (unconfirmed as of this file's creation, ask first)
ALTANA_API_KEY=
