# Copy this file to .env and fill in real values. Never commit .env itself.

# NOTE (updated): this project is now mainnet-only, testnet is no
# longer used anywhere. BSC_TESTNET_RPC_URL and
# BNB_AGENT_OPERATOR_PRIVATE_KEY are REMOVED, no backend-held wallet
# exists in this architecture, all signing happens client-side
# (Altana passkey wallet in the browser).

# 8004scan Developer Hub API key (free Pro tier for hackathon participants)
SCAN_8004_API_KEY=

# Practice Layer — our Anvil fork runs as ONE public Docker Web Service whose
# gateway has two doors (see anvil/gateway.py):
#   PRACTICE_RPC_URL    the PUBLIC, method-filtered door (safe eth_* reads +
#                       eth_sendRawTransaction). Used for status + as the
#                       forward target of the browser proxy /api/practice/rpc.
#                       e.g. https://anvil-practice-fork.onrender.com
#   PRACTICE_ADMIN_URL  the AUTHENTICATED door that forwards anvil_* cheats
#                       unfiltered — used ONLY server-side for funding.
#                       e.g. https://anvil-practice-fork.onrender.com/admin/rpc
#   PRACTICE_ADMIN_KEY  shared secret sent as X-Admin-Key; MUST match the value
#                       set on the anvil-practice-fork service.
# For bare local dev you may set only PRACTICE_RPC_URL to a raw Anvil
# (http://127.0.0.1:8545) and leave the admin vars empty.
PRACTICE_RPC_URL=
PRACTICE_ADMIN_URL=
PRACTICE_ADMIN_KEY=

# MongoDB, for permanent history: paper trades AND practice-layer runs,
# both keyed by wallet address so a user can revisit their own history.
MONGODB_URI=
MONGODB_DB_NAME=agents_marketplace
