# Copy this file to .env and fill in real values. Never commit .env itself.

# NOTE (updated): this project is now mainnet-only, testnet is no
# longer used anywhere. BSC_TESTNET_RPC_URL and
# BNB_AGENT_OPERATOR_PRIVATE_KEY are REMOVED, no backend-held wallet
# exists in this architecture, all signing happens client-side
# (Altana passkey wallet in the browser).

# 8004scan Developer Hub API key (free Pro tier for hackathon participants)
SCAN_8004_API_KEY=

# MongoDB, for permanent history (agent listings, job timing, etc.), keyed
# by wallet address where relevant so a user can revisit their own history.
MONGODB_URI=
MONGODB_DB_NAME=agents_marketplace
