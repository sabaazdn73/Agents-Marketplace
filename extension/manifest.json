{
  "manifest_version": 3,
  "name": "Tnega for Hyperliquid",
  "version": "0.1.0",
  "description": "Shows how a Hyperliquid address behaves: its post-only rejection rate, or the reason there is no rate to show.",

  "icons": {
    "16": "icons/hypurr-16.png",
    "32": "icons/hypurr-32.png",
    "48": "icons/hypurr-48.png",
    "128": "icons/hypurr-128.png"
  },

  "permissions": ["activeTab"],

  "host_permissions": ["https://agents-marketplace-q3k4.onrender.com/*"],

  "content_scripts": [
    {
      "matches": ["https://app.hyperliquid.xyz/*"],
      "js": ["shared.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Tnega for Hyperliquid",
    "default_icon": {
      "16": "icons/hypurr-16.png",
      "32": "icons/hypurr-32.png",
      "48": "icons/hypurr-48.png",
      "128": "icons/hypurr-128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/hypurr-128.png"],
      "matches": ["https://app.hyperliquid.xyz/*"]
    }
  ]
}
