{
  "manifest_version": 3,
  "name": "Tnega",
  "version": "0.2.0",
  "description": "Shows what this project has measured about the agent or address on the page you are looking at, or why it cannot say.",
  "homepage_url": "https://www.tnega.app/how-it-works",
  "icons": {
    "16": "icons/tnega-16.png",
    "32": "icons/tnega-32.png",
    "48": "icons/tnega-48.png",
    "128": "icons/tnega-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://agents-marketplace-q3k4.onrender.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.hyperliquid.xyz/*"
      ],
      "js": [
        "shared.js",
        "content.js",
        "paperSim.js",
        "paper.js"
      ],
      "css": [
        "panel.css",
        "paper.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://etherscan.io/address/*",
        "https://bscscan.com/address/*",
        "https://basescan.org/address/*",
        "https://arbiscan.io/address/*",
        "https://monadscan.com/address/*",
        "https://hyperevmscan.io/address/*",
        "https://robinhoodchain.blockscout.com/*"
      ],
      "js": [
        "shared.js",
        "agentPanel.js",
        "explorer.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://8004scan.io/*"
      ],
      "js": [
        "shared.js",
        "agentPanel.js",
        "scan8004.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tnega",
    "default_icon": {
      "16": "icons/tnega-16.png",
      "32": "icons/tnega-32.png",
      "48": "icons/tnega-48.png",
      "128": "icons/tnega-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/hypurr-128.png"
      ],
      "matches": [
        "https://app.hyperliquid.xyz/*"
      ]
    }
  ]
}
