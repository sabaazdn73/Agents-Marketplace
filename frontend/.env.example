# Frontend env (Vite). Copy to .env. All are optional in local dev (defaults
# shown), but set the wallet keys for real wallet flows and the API base for a
# split-host deploy.

# Backend base URL — every /api/* call (agents, build, practice) uses this.
# Default suits local dev (backend on :8000). Set to "" for a same-origin
# deploy, or to your backend's host in production.
VITE_API_BASE_URL=http://localhost:8000

# Practice Mode RPC the browser's burner wallet talks to. Defaults to
# `${VITE_API_BASE_URL}/api/practice/rpc` (the backend's allow-listed proxy,
# which keeps the Anvil admin RPC off the public internet). Override only if
# you expose the fork some other way.
VITE_PRACTICE_RPC_URL=

# Privy embedded-wallet app id (Face ID / email login). Get one at
# dashboard.privy.io. Without it, the Privy login path won't initialize.
VITE_PRIVY_APP_ID=

# WalletConnect project id for RainbowKit (MetaMask/Trust/WalletConnect).
# Get one free at cloud.walletconnect.com.
VITE_WALLETCONNECT_PROJECT_ID=
