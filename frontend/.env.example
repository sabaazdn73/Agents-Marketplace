# Frontend env (Vite). Copy to .env; all values are OPTIONAL — the defaults
# assume the frontend and backend are same-origin (the usual deploy).

# Where the browser sends backend API calls (agents, practice, etc.).
# Default "" = same origin. Set only if the backend is on another host.
VITE_API_BASE=

# Practice Mode RPC the browser's burner wallet talks to. Default is the
# backend's allow-listed proxy path "/api/practice/rpc" (same origin), which
# keeps the Anvil admin RPC and its cheat methods off the public internet.
# Only override if you expose the fork some other way.
VITE_PRACTICE_RPC_URL=/api/practice/rpc
