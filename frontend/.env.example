# Frontend env (Vite). Copy to .env. All are optional in local dev (defaults
# shown), but set the wallet keys for real wallet flows and the API base for a
# split-host deploy.

# Backend base URL — every /api/* call (agents, build, hire-adjacent) uses
# this. Default suits local dev (backend on :8000). Set to "" for a
# same-origin deploy, or to your backend's host in production.
VITE_API_BASE_URL=http://localhost:8000

# URL the "open on your phone" QR code points at. Defaults to this site's own
# origin (window.location.origin) — correct when the mobile app is the same
# responsive site. Set this only if the mobile app lives at a different URL.
VITE_MOBILE_URL=

# BSC mainnet read RPC for the read-only skills (copy-trade / wallet-tracker).
# They issue address-less topic getLogs, which the default public RPC refuses —
# point this at an RPC that permits it. Falls back to the SDK's public RPC, on
# which those two skills won't work.
VITE_MAINNET_READ_RPC=

# How many blocks back the read-only skills (copy-trade / wallet-tracker) scan
# by default. 1000 (~50 min of BSC) is what a dRPC-class read RPC comfortably
# serves; raise it on a read RPC that permits a wider address-less getLogs range.
VITE_SKILL_SCAN_BLOCKS=1000

# Privy embedded-wallet app id (Face ID / email login). Get one at
# dashboard.privy.io. Without it, the Privy login path won't initialize.
VITE_PRIVY_APP_ID=

# WalletConnect project id for RainbowKit (MetaMask/Trust/WalletConnect).
# Get one free at cloud.walletconnect.com.
VITE_WALLETCONNECT_PROJECT_ID=
