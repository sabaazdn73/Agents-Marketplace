# Copy this file to .env and fill in real values. Never commit .env itself.
# Vite requires the VITE_ prefix for any variable exposed to frontend code.

# Free WalletConnect Project ID from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# For the Face ID / email login path (Account Abstraction, ERC-4337).
# Pick ONE provider, Privy or Particle, get an app/project ID from
# whichever you choose:
VITE_PRIVY_APP_ID=
VITE_PARTICLE_PROJECT_ID=

# 8004scan API key, if the frontend ever calls it directly rather than
# through the backend (usually better to keep this backend-only instead)
VITE_SCAN_8004_API_KEY=
