   [
    "vault admin",
    "adds lending reserves (same token, klend-owned; the source comment says 'Need to trust the admin'); sets fees (performance up to 100%, management up to 10%) and the withdrawal penalty (up to 10%); names the allocation admin and the next admin; withdraws accrued fees"
   ],
   [
    "allocation admin",
    "changes weights and caps of reserves already added"
   ],
   [
    "global admin",
    "maintains the reserve whitelist and can turn a vault's whitelist flags off (Kamino's docs call them irreversible; the source disagrees)"
   ],
   [
    "lending-market owner",
    "sets each klend market's reserve configuration: collateral accepted, LTVs, oracles and caps"
   ]
  ],
  "moves": "No handler moves deposits to an arbitrary account (from reading the handler list). Risk paths: reserve selection, market owners' reserve settings, and program upgrade."
